{
  "name": "uifuzz",
  "version": "0.1.0",
  "description": "ストーリーもベースライン画像も書かずに、型から壊れる入力を探してUIの壊れを判定するCLI",
  "scripts": {
    "uifuzz": "tsx src/cli.ts",
    "typecheck": "tsc -p .",
    "demo:broken": "tsx src/cli.ts examples/UserCard.tsx --out out/broken",
    "demo:fixed": "tsx src/cli.ts examples/UserCardFixed.tsx --out out/fixed"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.28.2",
    "playwright": "^1.56.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mgmaru/uifuzz.git"
  }
}
